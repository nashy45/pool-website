# Copy to .env and fill in:   cp .env.example .env

# --- Domain / reverse proxy (Caddy) ---
# Caddy serves these hostnames and gets HTTPS certificates automatically.
# Use SITE_ADDRESS=:80 to test over plain HTTP before DNS points at the server.
SITE_ADDRESS=poolsarena.com, www.poolsarena.com

# Public website URL (used inside table QR codes)
PUBLIC_URL=https://poolsarena.com

# --- Security ---
# REQUIRED: generate with   openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Owner account created automatically on first start (only if no staff accounts exist)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-now

# --- Server (defaults are fine; Docker sets these itself) ---
PORT=3000
NODE_ENV=production
# DATA_DIR=/data
